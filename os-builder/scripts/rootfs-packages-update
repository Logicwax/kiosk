#!/usr/bin/env bash
# Regenerate the ROOTFS package locks (run via `make rootfs-update`).
#
# `os-builder/rootfs-packages.list` holds bare package names — apt is free to resolve
# them to whatever version is currently highest across the live+snapshot
# sources, so the shipped image drifts over time even though the snapshot date
# is fixed. This bootstraps the rootfs once and records the FULL resolved
# closure (every package apt actually installed, not just our top-level list)
# as exact pkg=version, plus a sha256 of every .deb.
#
# build-os.sh then installs exactly those versions via --variant=custom, so a
# rebuild months later is identical and package bumps become reviewable lock
# diffs. This script is the ONLY place --variant=important is used: it is how the
# set gets discovered in the first place.
[ -f /.dockerenv ] || { echo "Run inside the builder container"; exit 1; }
set -eu

CONFIG=/config
LOCK="$CONFIG/lock"
WORK=/tmp/rootfs-lock
: "${SOURCE_DATE_EPOCH:=1}"
export SOURCE_DATE_EPOCH

# Update the rootfs snapshot date to today, independently of the toolchain
# snapshot date in build-toolchain-debian.sources. Both files share the same format and live
# mirror stanzas; only the snapshot timestamp differs.
snapshot_url="http://snapshot.debian.org/archive/debian"
snapshot_date="$(date +%Y%m%dT000000Z)"
distro="$(grep VERSION_CODENAME /etc/os-release | cut -d= -f2)"

cat > "$LOCK/rootfs-debian.sources" <<-EOF
	Types: deb
	URIs: http://deb.debian.org/debian
	Suites: ${distro} ${distro}-updates
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no

	Types: deb
	URIs: ${snapshot_url}/${snapshot_date}
	Suites: ${distro} ${distro}-updates
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no

	Types: deb
	URIs: http://deb.debian.org/debian-security
	Suites: ${distro}-security
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no

	Types: deb
	URIs: ${snapshot_url}-security/${snapshot_date}
	Suites: ${distro}-security
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no
EOF
echo "==> rootfs snapshot date: ${snapshot_date}"

# Strip inline AND whole-line `#` comments (same convention as
# build-toolchain-pkgs.list) — an unstripped inline comment reaches apt as bogus
# package names and fails the bootstrap.
PKG_LIST="$(sed 's/#.*//; s/[[:space:]]*$//' "$CONFIG/rootfs-packages.list" | grep -v '^$' | paste -sd, -)"

rm -rf "$WORK"; mkdir -p "$WORK"
# NOTE on the `trixie` argument below: mmdebstrap takes SUITE TARGET [MIRROR...].
# Because we pass an explicit deb822 sources file as MIRROR, that file governs
# package resolution AND is copied verbatim into the target's apt config — the
# SUITE is inert (verified: passing 'bookworm' still produced a trixie rootfs).
# It is positionally required, so keep it matching rootfs-debian.sources; nothing will
# warn you if the two drift apart.
echo "==> resolving the rootfs package closure"
# Keep the downloaded .debs so we can hash them (apt/mmdebstrap clean by default).
mmdebstrap \
	--mode=unshare \
	--variant=important \
	--format=directory \
	--include="$PKG_LIST" \
	--aptopt='APT::Keep-Downloaded-Packages "true"' \
	--extract-hook='mkdir -p /tmp/rootfs-lock/archives && cp -n "$1"/var/cache/apt/archives/*.deb /tmp/rootfs-lock/archives/ 2>/dev/null || true' \
	--customize-hook='mkdir -p /tmp/rootfs-lock/archives && cp -n "$1"/var/cache/apt/archives/*.deb /tmp/rootfs-lock/archives/ 2>/dev/null || true' \
	trixie \
	"$WORK/root" \
	"$LOCK/rootfs-debian.sources"

# Version lock: parse the target's dpkg status directly (no chroot needed).
python3 - "$WORK/root/var/lib/dpkg/status" "$LOCK/rootfs-package-version-lock.list" <<'PY'
import sys
status, out = sys.argv[1], sys.argv[2]
pkgs, cur = [], {}
for block in open(status, encoding="utf-8", errors="replace").read().split("\n\n"):
    d = {}
    for line in block.splitlines():
        if line[:1].isspace() or ":" not in line:
            continue
        k, _, v = line.partition(":")
        d[k.strip()] = v.strip()
    if d.get("Package") and "installed" in d.get("Status", ""):
        pkgs.append(f"{d['Package']}={d['Version']}")
open(out, "w").write("\n".join(sorted(pkgs)) + "\n")
print(f"locked {len(pkgs)} rootfs packages")
PY

# Hash lock: sha256 of every .deb downloaded for that closure. Collected at BOTH
# hook points because --variant=important wipes the apt cache after unpacking the
# essential set, so the bootstrap packages are only visible at extract. The BUILD
# uses --variant=custom, where all of them arrive in one batch — but discovery has
# to run as `important` precisely to find out what that set is.
if compgen -G "$WORK/archives/*.deb" > /dev/null; then
	( cd "$WORK/archives" \
		&& find . -type f -iname '*.deb' -exec sha256sum {} \; \
		| sed 's|\./||g' | LC_ALL=C sort \
	) > "$LOCK/rootfs-package-hash-lock.txt"
	echo "hashed $(wc -l < "$LOCK/rootfs-package-hash-lock.txt") .deb files"
else
	# Never leave a stale lock in place while reporting success: the build would
	# then verify against versions this run never actually resolved.
	echo "ERROR: no .debs were captured — refusing to leave a stale hash lock." >&2
	exit 1
fi

# Remove any per-stage locks left over from the earlier two-list design, so a
# stale file cannot be picked up by a build that no longer expects it.
rm -f "$LOCK"/rootfs-bootstrap-package-hash-lock.txt \
      "$LOCK"/rootfs-apt-package-hash-lock.txt \
      "$LOCK"/rootfs-package-hash-lock-bootstrap.txt \
      "$LOCK"/rootfs-package-hash-lock-apt.txt

chown -R "${LOCAL_USER:-0}" "$LOCK"
rm -rf "$WORK"
