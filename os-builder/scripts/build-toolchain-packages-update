#!/usr/bin/env bash
# Regenerate the Debian apt lock files (run via `make builder-update`).
#
# Scoped to the Debian packages this builder adds on top of the digest-pinned base
# image. Writes a deb822 debian.sources listing the live mirror first and a frozen
# snapshot.debian.org timestamp second (failover URIs): apt prefers live for
# downloads and falls back to the snapshot for anything live has pruned, with
# signatures verified.
[ -f /.dockerenv ] || { echo "Run inside the builder container"; exit 1; }
set -e

snapshot_url="http://snapshot.debian.org/archive/debian"
snapshot_date="$(date +%Y%m%dT000000Z)"
distro="$(grep VERSION_CODENAME /etc/os-release | cut -d= -f2)"

cat > /etc/apt/sources.list.d/debian.sources <<-EOF
	Types: deb
	URIs: http://deb.debian.org/debian
	Suites: ${distro} ${distro}-updates
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no

	Types: deb
	URIs: ${snapshot_url}/${snapshot_date}
	Suites: ${distro} ${distro}-updates
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no

	Types: deb
	URIs: http://deb.debian.org/debian-security
	Suites: ${distro}-security
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no

	Types: deb
	URIs: ${snapshot_url}-security/${snapshot_date}
	Suites: ${distro}-security
	Components: main
	Signed-By: /usr/share/keyrings/debian-archive-keyring.pgp
	Check-Valid-Until: no
EOF
cp /etc/apt/sources.list.d/debian.sources /config/lock/build-toolchain-debian.sources

apt-get update
# Download (only) the packages we add plus any not-yet-present dependencies.
apt-get install -y --download-only $(sed 's/#.*//' /config/build-toolchain-pkgs.list)

# Hash-lock: sha256 of every downloaded .deb (supply-chain integrity).
( cd /var/cache/apt/archives \
	&& find . -type f -iname '*.deb' -exec sha256sum {} \; \
	| sed 's|\./||g' | LC_ALL=C sort \
) > /config/lock/build-toolchain-hash-lock.txt

# Version-lock: exact pkg=version for each downloaded .deb.
for deb in /var/cache/apt/archives/*.deb; do
	echo "$(dpkg-deb -f "$deb" Package)=$(dpkg-deb -f "$deb" Version)"
done | LC_ALL=C sort > /config/lock/build-toolchain-version-lock.list

chown -R "${LOCAL_USER:-0}" /config/lock
echo "Locked $(wc -l < /config/lock/build-toolchain-version-lock.list) OS-builder packages (live + snapshot ${snapshot_date})"
